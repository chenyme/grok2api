# grok2api administrator API. Keep the deployed file mode at 0600.
GROK2API_BASE_URL=http://127.0.0.1:8000
GROK2API_ADMIN_USERNAME=admin
GROK2API_ADMIN_PASSWORD=replace-me
# Alternatively, leave the variable above empty and use a mounted secret file.
# GROK2API_ADMIN_PASSWORD_FILE=/run/secrets/grok2api_admin_password

# Use a dedicated, unlimited client key created only for quality probes.
QUALITY_GUARD_CLIENT_KEY_ID=1
QUALITY_GUARD_MODEL=grok-4.5

# Optional comma-separated IDs. Empty means all enabled proxied grok_build nodes.
QUALITY_GUARD_NODE_IDS=

QUALITY_GUARD_MODE=hybrid
QUALITY_GUARD_ACTIVE_INTERVAL_SECONDS=1800
QUALITY_GUARD_PASSIVE_POLL_SECONDS=5
QUALITY_GUARD_PASSIVE_PAGE_SIZE=200
QUALITY_GUARD_PASSIVE_MAX_PAGES=10
QUALITY_GUARD_JITTER_SECONDS=30
QUALITY_GUARD_REQUEST_TIMEOUT_SECONDS=120
QUALITY_GUARD_SOFT_TPS=500
QUALITY_GUARD_HARD_TPS=1000
QUALITY_GUARD_CONSECUTIVE_SOFT=2
QUALITY_GUARD_CONSECUTIVE_ERRORS=2
QUALITY_GUARD_QUARANTINE_SECONDS=300
QUALITY_GUARD_MIN_HEALTHY_NODES=3
QUALITY_GUARD_MAX_OUTPUT_TOKENS=384

# Optional strict mode. Suspect nodes leave scheduling before confirmation.
QUALITY_GUARD_FAIL_CLOSED=false
QUALITY_GUARD_MIN_GENERATION_MS=1000

# Optional internal IP-rotation webhook.
QUALITY_GUARD_ROTATION_URL=
QUALITY_GUARD_ROTATION_TOKEN=
QUALITY_GUARD_ROTATION_TIMEOUT_SECONDS=45
QUALITY_GUARD_ROTATABLE_NODE_IDS=

QUALITY_GUARD_STATE_FILE=/var/lib/grok2api-quality-guard/state.json
QUALITY_GUARD_LOCK_FILE=/var/lib/grok2api-quality-guard/guard.lock
QUALITY_GUARD_RUNTIME_CONFIG_FILE=/var/lib/grok2api-quality-guard/runtime-config.json
QUALITY_GUARD_INSECURE_TLS=false
