# Compose reads this file automatically when it is copied to .env.
GROK2API_IMAGE=ghcr.io/hengxin666/grok2api:latest
GROK2API_PORT=127.0.0.1:8000
GROK2API_CONFIG=./config.yaml
QUALITY_GUARD_ENV_FILE=./tools/egress-quality-guard/egress-quality-guard.env
TZ=Asia/Shanghai

# DNS servers used inside the containers. Set these to resolvers reachable
# from the deployment host when 1.1.1.1 or 8.8.8.8 is unavailable.
GROK2API_DNS_PRIMARY=1.1.1.1
GROK2API_DNS_SECONDARY=8.8.8.8
